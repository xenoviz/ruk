{
  "name": "@xenoviz/ruk",
  "version": "0.3.0-beta.3",
  "description": "Dependency-aware Git workspaces for parallel coding agents",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "bun run typecheck && bun run docs:typecheck && bun run check:package && bun run check:repository-policy",
    "check:package": "bun scripts/verify-package.ts",
    "check:repository-policy": "bun scripts/verify-repository-policy.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test:conformance": "bun scripts/conformance/run.ts",
    "binary:build": "bun scripts/build-binary.ts",
    "binary:check": "bun scripts/verify-binary.ts",
    "binary:cross-check": "bun scripts/verify-cross-binaries.ts",
    "docs:typecheck": "tsc -p website/tsconfig.json",
    "docs:dev": "vitepress dev website",
    "docs:build": "bun run docs:typecheck && vitepress build website",
    "docs:preview": "vitepress preview website",
    "pack:check": "bun scripts/verify-pack.ts",
    "benchmark:runtime": "bun scripts/benchmark-runtime.ts",
    "repo:protect": "bun scripts/configure-repository.ts --apply"
  },
  "engines": {
    "bun": ">=1.3.14",
    "node": ">=22.14"
  },
  "packageManager": "bun@1.3.14",
  "keywords": [
    "git",
    "worktree",
    "monorepo",
    "agents",
    "go",
    "golang",
    "bun",
    "pnpm"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xenoviz/ruk.git"
  },
  "bugs": {
    "url": "https://github.com/xenoviz/ruk/issues"
  },
  "homepage": "https://github.com/xenoviz/ruk#readme",
  "devDependencies": {
    "@types/node": "22.20.1",
    "typescript": "7.0.2",
    "vitepress": "1.6.4",
    "vue": "3.5.40"
  },
  "overrides": {
    "vite": "6.4.3"
  }
}
